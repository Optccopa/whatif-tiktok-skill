+def bell(dur: float = 6.0, f0: float = 330.0) -> np.ndarray:
+    """A church bell strike: inharmonic partials (hum, prime, minor third, fifth, nominal) ringing down."""
+    n = int(dur * SR)
+    t = np.arange(n) / SR
+    y = sum(a * np.sin(2 * np.pi * f0 * r * t) * np.exp(-t / d)
+            for r, a, d in ((0.5, 0.5, 3.0), (1.0, 1.0, 2.2), (1.19, 0.6, 1.6), (1.5, 0.4, 1.2), (2.0, 0.5, 0.9)))
+    return y * np.minimum(t / 0.004, 1.0)
+
+
+def _village(mix: Mix, tl: Timeline, curve, fx, alive) -> None:
+    """Dusk bells, the gondola's hum until the power dies, then avalanches roaring off the slopes."""
+    from whatif.village import avalanche
+
+    for k, at in enumerate((0.6, 3.4, 6.2, 9.0)):  # the church rings in the evening
+        mix.add(bell(), at, 0.05 * (0.85 ** k), -0.3)
+    power = curve([f.power for f in fx])
+    hum = np.sin(2 * np.pi * 96 * mix.t) + 0.4 * np.sin(2 * np.pi * 192 * mix.t)
+    mix.add(hum + 0.5 * mix.noise(200, 1200, 1.0), 0, 0.006 * np.clip((power - 0.15) / 0.85, 0, 1) * alive, 0.5)
+    snow = curve([avalanche(tl, f.t) for f in fx])
+    mix.add(mix.noise(25, 1800, 1.2), 0, 0.3 * snow * alive, -0.2)
+    mix.add(mix.noise(25, 1800, 1.2), 0, 0.3 * snow * alive, 0.3)
+
