+            mix.add(tone(f0, f0 * 1.8, rng.uniform(0.04, 0.09), (1.0, 0.3)), x, 0.05 * k, rng.uniform(-0.6, 0.6))
+        x += rng.exponential(0.03)
+    # Fire: crackles from 451 (paper), a roar once the umbrellas, thatch and wood go.
