+def _steel_pan(mix: Mix, power: np.ndarray) -> None:
+    """A beach-bar steel-pan tune: bell-like plucks that sag in pitch and stop when the power goes."""
+    notes = np.array([0, 4, 7, 9, 7, 4, 2, 4, 7, 12, 9, 7, 4, 2, 0, 2])
+    beat = 0.28
+    t = mix.t
+    f = 330.0 * 2 ** (notes[(t / beat).astype(int) % len(notes)] / 12.0) * np.maximum(power ** 0.35, 0.3)
+    within = np.mod(t, beat) / beat
+    env = np.minimum(within / 0.02, 1.0) * np.exp(-within * 4.0)
+    phase = 2 * np.pi * np.cumsum(f) / SR
+    mix.add((np.sin(phase) + 0.4 * np.sin(2 * phase) + 0.2 * np.sin(3.98 * phase)) * env, 0,
+            0.02 * np.clip(power * 1.3, 0, 1), 0.35)
+
+
+def _beach(mix: Mix, tl: Timeline, over, alive) -> None:
+    rng = mix.rng
+    temp = tl.temp_f
+    # Waves breaking on the sand, all the way through (the sea boils, it doesn't stop).
+    swell = np.zeros(mix.n)
+    x = rng.uniform(0, 2)
+    while x < tl.seconds:
+        i = int(x * SR)
+        n = min(int(5 * SR), mix.n - i)
+        tt = np.arange(n) / SR
+        swell[i:i + n] += np.minimum(tt / 1.0, 1.0) ** 2 * np.exp(-np.maximum(tt - 1.0, 0) / 1.8)
+        x += rng.uniform(3.5, 6.0)
+    mix.add(mix.noise(100, 3000, 1.0), 0, (0.04 + 0.07 * swell) * alive, -0.3)
+    mix.add(mix.noise(100, 3000, 1.0), 0, (0.04 + 0.07 * np.roll(swell, int(1.3 * SR))) * alive, 0.3)
+    _crowd(mix, over(lambda x: 1 - ramp(temp(x), 110.0, 175.0)) * alive)
+    _screams(mix, tl.time_at_temp(115.0), tl.time_at_temp(170.0), 5, 0.014, alive)
+    _steel_pan(mix, over(lambda x: 1 - ramp(temp(x), 255.0, 290.0)) * alive)
+    for _ in range(5):
+        mix.add(gull_call(rng), rng.uniform(0.5, 11), rng.uniform(0.015, 0.035), rng.uniform(-0.7, 0.7))
+    # The sea boils from 213: a hiss and low bubbles that never let up.
+    boil = over(lambda x: ramp(temp(x), 211.0, 240.0))
+    mix.add(mix.noise(1500, 8000, 0.6), 0, 0.03 * boil * alive, -0.3)
+    x = tl.time_at_temp(211.0)
+    while x < tl.seconds - 0.5:
+        k = float(boil[min(int(x * SR), mix.n - 1)])
