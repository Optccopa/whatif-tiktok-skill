+        tops, yaws, lens = [], [], []
+        for top, yaw0, length, seed in self.palms:
+            n = 8
+            yaw = yaw0 + np.arange(n) * 2 * np.pi / n + 0.12 * np.sin(np.arange(n) * 2.3 + seed)
