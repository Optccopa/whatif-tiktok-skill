+"""The ski scene: an alpine ski village at dusk, seen from a chalet balcony, for space stories.
+
+Layout (meters, y up): the camera stands on a balcony 22 m above the village street (x=0, z=60)
+and looks north (-z) down the street, which is lined with chalets, lamps and string lights, to a
+white church with a spire (x=28, z=-230). The village sits on a flat valley floor (y=10). On the
+right the ski mountain rises to ~400 m around (430, -1700): a lit piste comes down its face to the
+village beside a chairlift. A forested wall closes the left. A low snowy range (4-7 degrees up)
+ends the valley 3-8 km away, under the open sky where the body rises (az -3, el 11.5).
+Sky and light come from video.ski_look (blue hour, alpenglow, then night lit by the body).
+"""
+
+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+from whatif import props
+from whatif.forest import _smooth, fbm
+from whatif.meshes import BUILDING, GLOW, GROUND, Instances, beam, chain, rgb, ry, sc, tr
+from whatif.scenario import Effects, Timeline, ramp
+
+TERRAIN = 8
+VILLAGE_Y = 10.0
+CAMERA = np.array([0.0, VILLAGE_Y + 22.0, 60.0])
+LOOK = CAMERA + np.array([0.0, -60.0, -1000.0])  # about 3.4 degrees down
+BODY_AZ_EL = (-3.0, 11.5)
+MOON_AZ_EL = (-12.0, 11.0)
+CHURCH = np.array([28.0, VILLAGE_Y, -230.0])
+SKI_TOP = np.array([300.0, 0.0, -1480.0])  # the piste, top to bottom (y filled from the terrain)
+SKI_BOTTOM = np.array([95.0, 0.0, -560.0])
+LIFT = (np.array([70.0, 0.0, -540.0]), np.array([255.0, 0.0, -1440.0]))
+STREET_HALF = 4.5
+WOOD = ["#7a4a30", "#8a5a3a", "#6b4a35", "#a0623e"]
+PLASTER = ["#efe6d8", "#e6dccb", "#d9cdb8", "#f2efe8"]
+
+
+def terrain_height(x, z):
+    x, z = np.asarray(x, dtype=float), np.asarray(z, dtype=float)
+    d = CAMERA[2] - z  # distance ahead of the balcony
+    village = _smooth((np.hypot(x * 0.9, z + 140.0) - 260.0) / 260.0)  # 0 on the flat village floor
+    h = VILLAGE_Y + village * 16.0 * (fbm(x / 260.0, z / 260.0, 1.0) - 0.35)
+    h = h + _smooth((-x - 150.0) / 650.0) * (330.0 + 180.0 * (fbm(x / 500.0, z / 500.0, 4.0) - 0.5))  # left wall
+    # The ski mountain: a dome, narrower on its left flank so the valley end stays open.
+    dx = np.where(x < 430.0, (x - 430.0) * 1.8, x - 430.0)
+    dome = _smooth(1.0 - np.hypot(dx, z + 1700.0) / 1300.0)
+    h = h + dome * 400.0 * (0.85 + 0.3 * fbm(x / 300.0, z / 300.0, 6.0))
+    h = h + _smooth((x - 300.0) / 700.0) * _smooth((d - 500.0) / 600.0) * 280.0  # right wall, mostly off-frame
+    ridges = 1.0 - np.abs(2.0 * fbm(x / 900.0, z / 900.0, 5.0) - 1.0)
+    far = _smooth((d - 2600.0) / 2200.0) * (240.0 + 200.0 * fbm(x / 1400.0, z / 1400.0, 3.0) + 280.0 * ridges ** 2)
+    h = h + far * (0.8 + 0.6 * _smooth((np.abs(x) - 500.0) / 1800.0))
+    return h + 18.0 * (fbm(x / 160.0, z / 160.0, 9.0) - 0.5) * _smooth((d - 700.0) / 600.0)
+
+
+def terrain_mesh() -> np.ndarray:
+    zs = np.concatenate([np.arange(130.0, -700.0, -10.0), np.arange(-700.0, -2400.0, -18.0),
+                         np.arange(-2400.0, -9500.0, -70.0)])
+    xs = np.concatenate([np.arange(-3600.0, -1500.0, 60.0), np.arange(-1500.0, 1500.0, 12.0),
+                         np.arange(1500.0, 3601.0, 60.0)])
+    X, Z = np.meshgrid(xs, zs)
+    P = np.stack([X, terrain_height(X, Z), Z], -1)
+    a, b, c, d = P[:-1, :-1], P[:-1, 1:], P[1:, :-1], P[1:, 1:]
+    return np.stack([np.stack([a, b, d], -2), np.stack([a, d, c], -2)], 2).reshape(-1, 3).astype(np.float32)
+
+
+def _on_ground(p) -> np.ndarray:
+    p = np.array(p, dtype=float)
+    p[..., 1] = terrain_height(p[..., 0], p[..., 2])
+    return p
+
+
+def _dist_to_segment(x, z, a, b):
+    ab = b[[0, 2]] - a[[0, 2]]
+    k = np.clip(((x - a[0]) * ab[0] + (z - a[2]) * ab[1]) / (ab @ ab), 0.0, 1.0)
+    return np.hypot(x - a[0] - k * ab[0], z - a[2] - k * ab[1])
+
+
+def piste_center(s):
+    """Points down the piste: s=0 at the top, 1 at the bottom, with a lazy S."""
+    s = np.asarray(s, dtype=float)[..., None]
+    p = SKI_TOP * (1 - s) + SKI_BOTTOM * s
+    p[..., 0] += 45.0 * np.sin(s[..., 0] * 2.6 * np.pi)
+    return _on_ground(p)
+
+
+def _dist_to_piste(x, z):
+    c = piste_center(np.linspace(0, 1, 60))
+    return np.min(np.hypot(x[:, None] - c[None, :, 0], z[:, None] - c[None, :, 2]), axis=1)
+
+
+class Ski:
+    body_az_el = BODY_AZ_EL
+    moon_az_el = MOON_AZ_EL
+
+    def __init__(self, timeline: Timeline, seed: int = 0):
+        self.timeline = timeline
+        rng = np.random.default_rng(seed + 41)
+        self.camera_pos = CAMERA.copy()
+        self.meshes = {"terrain": terrain_mesh()}
+        self.static = Instances()
+        self.static.add("terrain", np.eye(4), rgb("#e8ecf2"), 0.0, TERRAIN)
+        self.lamps: list[tuple] = []
+        self._street(rng)
+        self._chalets(rng)
+        self._church()
+        self._trees(rng)
+        self._lift_and_piste(rng)
+        self._balcony()
+        self._crowd(rng)
+        self._avalanches(rng)
+        self._skiers(rng)
+
+    # Static -----------------------------------------------------------------
+
+    def _street(self, rng) -> None:
+        s = self.static
+        s.add("box", props.block(-STREET_HALF, STREET_HALF, VILLAGE_Y - 0.5, VILLAGE_Y + 0.06, -262, 56),
+              rgb("#6e6670"), 0.0, GROUND)
+        s.add("box", props.block(-8, 52, VILLAGE_Y - 0.5, VILLAGE_Y + 0.05, -262, -196), rgb("#7a7078"), 0.0, GROUND)
+        zs = np.arange(44.0, -250.0, -20.0)
+        for side in (-1, 1):
+            for z in zs:
+                self.lamps.append(props.lamp_post(s, side * (STREET_HALF + 0.8), z, y0=VILLAGE_Y, h=4.4))
+        for z0, z1 in zip(zs[:-1], zs[1:]):  # bulbs zigzagging across the street
+            props.string_lights(s, (-STREET_HALF - 0.8, VILLAGE_Y + 4.9, z0), (STREET_HALF + 0.8, VILLAGE_Y + 4.9, z1),
+                                sag=0.8, n=14, rng=rng)
+
+    def _chalet(self, x, z, yaw, rng, big=1.0) -> tuple:
+        s = self.static
+        w, d = rng.uniform(9, 12) * big, rng.uniform(10, 13) * big
+        low, high = 3.3, rng.uniform(2.6, 5.4) * big
+        y = VILLAGE_Y - 0.3
+        base = chain(tr((x, y, z)), ry(yaw))
+        s.add("box", chain(base, sc((w, low, d))), rgb(rng.choice(PLASTER)), 0.0, BUILDING,
+              seed=rng.uniform(0, 100), p1=rng.uniform(0.45, 0.8))
+        s.add("box", chain(base, tr((0, low, 0)), sc((w, high, d))), rgb(rng.choice(WOOD)), 0.0, BUILDING,
+              seed=rng.uniform(0, 100), p1=rng.uniform(0.35, 0.7))
+        roof_h = rng.uniform(3.0, 4.2) * big
+        top = low + high
+        s.add("prism", chain(base, tr((0, top, 0)), sc((w + 1.8, roof_h, d + 1.8))), rgb("#3b2f2c"))
+        s.add("box", chain(base, tr((0, low + 0.2, d / 2 + 0.6)), sc((w * 0.8, 0.9, 1.2))), rgb("#5a3b28"))  # balcony
+        cx, cz = w * 0.22, -d * 0.2
+        chimney = np.array([x + cx * math.cos(yaw) + cz * math.sin(yaw), y + top + roof_h * 0.6,
+                            z - cx * math.sin(yaw) + cz * math.cos(yaw)])
+        s.add("box", chain(tr(chimney), sc((0.8, 1.8, 0.8))), rgb("#5a4a42"))
+        roof = np.array([x, y + top + roof_h * 0.5, z])
+        door = np.array([x + math.sin(yaw) * (d / 2 + 0.5), VILLAGE_Y, z + math.cos(yaw) * (d / 2 + 0.5)])
+        return chimney + (0, 1.9, 0), roof, door, max(w, d)
+
+    def _chalets(self, rng) -> None:
+        self.chimneys, self.roofs, self.doors, sizes = [], [], [], []
+        placed = []
+        for z in np.arange(30.0, -250.0, -17.0):  # gable ends facing the street
+            for side in (-1, 1):
+                if side > 0 and -270 < z < -180:
+                    continue  # the church square
+                x = side * rng.uniform(13.5, 15.5)
+                placed.append((x, z))
+                out = self._chalet(x, z + rng.uniform(-1.2, 1.2), -side * math.pi / 2, rng)
+                self._keep(out)
+        tries = 0
+        while len(placed) < 150 and tries < 5000:
+            tries += 1
+            x, z = rng.uniform(-230, 230), rng.uniform(-470, 20)
+            if abs(x) < 26 and z > -265 or np.hypot(x - CHURCH[0], z - CHURCH[2]) < 34:
+                continue
+            if np.hypot(x * 0.9, z + 140.0) > 270 or any(math.hypot(x - px, z - pz) < 19 for px, pz in placed):
+                continue
+            placed.append((x, z))
+            self._keep(self._chalet(x, z, rng.choice([0.0, math.pi / 2, -math.pi / 2]) + rng.uniform(-0.2, 0.2),
+                                    rng, rng.uniform(0.9, 1.2)))
+        self.placed = np.array(placed)
+        f = np.array(self.roofs)
+        self.fires = dict(x=f[:, 0], y=f[:, 1], z=f[:, 2], size=rng.uniform(5.0, 9.0, len(f)),
+                          threshold=rng.uniform(0.05, 1.0, len(f)), seed=rng.uniform(0, 100, len(f)))
+        self.chimneys = np.array(self.chimneys)
+
+    def _keep(self, out) -> None:
+        chimney, roof, door, _ = out
+        self.chimneys.append(chimney)
+        self.roofs.append(roof)
+        self.doors.append(door)
+
+    def _church(self) -> None:
+        s = self.static
+        x, y, z = CHURCH
+        white = rgb("#f2efe8")
+        s.add("box", props.block(x - 6, x + 6, y - 0.3, y + 9, z - 26, z), white, 0.0, BUILDING, seed=11.0, p1=0.5)
+        s.add("prism", chain(tr((x, y + 9, z - 13)), sc((13.4, 5.5, 27.4))), rgb("#4a3a34"))
+        s.add("box", props.block(x - 3.4, x + 3.4, y - 0.3, y + 27, z - 3.4 + 2, z + 3.4 + 2), white, 0.0,
+              BUILDING, seed=4.0, p1=0.3)
+        s.add("box", props.block(x - 3.7, x + 3.7, y + 27, y + 28.2, z - 1.7, z + 5.7), rgb("#d8d2c8"))
+        s.add("cone6", chain(tr((x, y + 28.2, z + 2)), ry(0.26), sc((7.4, 15.0, 7.4))), rgb("#3d5a52"))
+        s.add("cyl", chain(tr((x, y + 22.5, z + 5.45)), sc((2.6, 0.1, 2.6)), tr((0, 0, 0))), rgb("#fff1d0"), 3.5, GLOW,
+              p2=1.0)
+        self.doors += [np.array([x - 8.0, y, z + 6.0]), np.array([x + 8.0, y, z + 6.0])]  # shelter in the church
+        for dx in (-9.0, 9.0):  # floodlights on the square
+            self.lamps.append(props.lamp_post(s, x + dx, z + 14, y0=y, h=4.4))
+
+    def _trees(self, rng) -> None:
+        n = 60000
+        x = rng.uniform(-1900, 1900, n)
+        z = rng.uniform(-2600, 40, n)
+        keep = np.abs(x) < 0.36 * (CAMERA[2] - z) + 60
+        x, z = x[keep], z[keep]
+        h = terrain_height(x, z)
+        slope = np.hypot(terrain_height(x + 3, z) - terrain_height(x - 3, z),
+                         terrain_height(x, z + 3) - terrain_height(x, z - 3)) / 6
+        village = np.hypot(x * 0.9, z + 140.0)
+        keep = (h < 430) & (slope < 0.9) & ((village > 300) | ((village > 40) & (rng.random(len(x)) < 0.025)))
+        keep &= (np.abs(x) > 12) | (z < -270)
+        x, z, h = x[keep], z[keep], h[keep]
+        keep = (_dist_to_piste(x, z) > 42) & (_dist_to_segment(x, z, *LIFT) > 9)
+        keep &= (CAMERA[2] - z < 1500) | (rng.random(len(x)) < 0.6)
+        x, z, h = x[keep], z[keep], h[keep]
+        m = len(x)
+        height = rng.uniform(9, 19, m)
+        greens = np.array([rgb(c) for c in ("#17301f", "#1c3a25", "#21422a", "#14291b")])
+        color = greens[rng.integers(0, len(greens), m)] * rng.uniform(0.85, 1.1, (m, 1))
+        base = chain(tr(np.stack([x, h - 0.5, z], 1)), ry(rng.uniform(0, 2 * np.pi, m)))
+        s = self.static
+        s.add("cone6", chain(base, sc(np.stack([height * 0.46, height * 0.55, height * 0.46], 1))), color)
+        s.add("cone6", chain(base, tr(np.stack([np.zeros(m), height * 0.38, np.zeros(m)], 1)),
+                             sc(np.stack([height * 0.32, height * 0.62, height * 0.32], 1))), color * 1.1)
+        self.tree_count = m
+
+    def _lift_and_piste(self, rng) -> None:
+        s = self.static
+        a, b = _on_ground(LIFT[0]), _on_ground(LIFT[1])
+        k = np.linspace(0, 1, 10)
+        towers = _on_ground(a[None] * (1 - k[:, None]) + b[None] * k[:, None])
+        steel = rgb("#5a5e6a")
+        s.add("box", chain(tr(towers), sc((1.4, 15.0, 1.4))), steel)
+        tops = towers + (0, 15.0, 0)
+        s.add("box", beam(tops - (3.5, 0, 0), tops + (3.5, 0, 0), 0.7), steel)
+        self.cables = [tops + (side * 3.2, -0.3, 0) for side in (-1, 1)]
+        for c in self.cables:
+            s.add("box", beam(c[:-1], c[1:], 0.35), rgb("#2a2a30"))
+        for p, w in ((a, 16.0), (b, 12.0)):  # stations with lit windows
+            s.add("box", props.block(p[0] - w / 2, p[0] + w / 2, p[1] - 1, p[1] + 7, p[2] - 6, p[2] + 6),
+                  rgb("#b8a590"), 0.0, BUILDING, seed=rng.uniform(0, 100), p1=0.7)
+            s.add("prism", chain(tr((p[0], p[1] + 7, p[2])), sc((w + 1.5, 3.0, 13.5))), rgb("#3b2f2c"))
+        # Floodlights down both edges of the piste (night skiing).
+        c = piste_center(np.linspace(0.02, 0.98, 16))
+        for side in (-1, 1):
+            p = c + np.array([side * 40.0, 0.0, side * 8.0])
+            p = _on_ground(p)
+            s.add("cyl5", chain(tr(p), sc((0.8, 14.0, 0.8))), rgb("#3a3a42"))
+            s.add("ico", chain(tr(p + (0, 14.5, 0)), sc(3.2)), rgb("#fff1d6"), 9.0, GLOW, p2=1.0)
+
+    def _balcony(self) -> None:
+        cx, cy, cz = CAMERA
+        wood, z = rgb("#4a3020"), cz - 3.2
+        s = self.static
+        for y in (cy - 0.9, cy - 1.55):
+            s.add("box", chain(tr((cx, y - 0.07, z)), sc((8.0, 0.14, 0.14))), wood)
+        for x in (cx - 0.97, cx + 1.9):
+            s.add("box", chain(tr((x, cy - 2.1, z)), sc((0.16, 1.3, 0.16))), wood)
+        s.add("box", chain(tr((cx, cy - 2.25, cz - 1.5)), sc((9.0, 0.3, 4.4))), rgb("#5a3b28"))
+        s.add("box", props.block(cx - 9, cx + 9, VILLAGE_Y - 0.3, cy - 2.25, cz + 0.5, cz + 16), rgb("#7a4a30"))
+
+    def _crowd(self, rng) -> None:
+        self.crowd = props.Crowd(rng, [(70, (-3.6, 3.6), (-245.0, 40.0), 1), (24, (-4.0, 46.0), (-255.0, -200.0), 0)],
+                                 y_at=lambda x, z: np.full_like(x, VILLAGE_Y + 0.06), standing=0.25, exit_speed=5.0)  # they run
+        p, n = self.crowd.p, self.crowd.n
+        az, el = BODY_AZ_EL
+        p["stop"] = 20.0 + rng.uniform(0, 4.0, n)  # everyone stops to look up at it
+        p["stare"] = np.full(n, math.atan2(math.sin(math.radians(az)), -math.cos(math.radians(az)))) + rng.uniform(-0.3, 0.3, n)
+        p["leave"] = self.timeline.t_flood - 2.8 + rng.uniform(0, 3.0, n)  # the shaking sends them indoors
+        doors = np.array(self.doors)
+        x, z = self.crowd.positions(float(p["leave"].min()))[:2]  # where they stand when the shaking starts
+        near = np.argmin(np.hypot(doors[None, :, 0] - x[:, None], doors[None, :, 2] - z[:, None]), axis=1)
+        p["exit"] = doors[near]
+
+    def _avalanches(self, rng) -> None:
+        """Slopes that let go once the shaking is strong: each a path down the fall line."""
+        # (start, end) on faces we can see: the ski mountain, the left wall, the far range.
+        paths = [((200, -1350), (30, -760)), ((-380, -1000), (-170, -760)), ((350, -1430), (260, -960)),
+                 ((-480, -1500), (-210, -1250)), ((-620, -1950), (-360, -1700)), ((120, -1150), (20, -690))]
+        t0 = self.timeline.t_flood - 1.0  # the shaking is already strong
+        self.slides = []
+        for i, (a, b) in enumerate(paths):
+            k = np.linspace(0, 1, 90)[:, None]
+            pts = _on_ground(np.array([a[0], 0, a[1]]) * (1 - k) + np.array([b[0], 0, b[1]]) * k)
+            seg = np.r_[0.0, np.cumsum(np.linalg.norm(np.diff(pts, axis=0), axis=1))]
+            self.slides.append(dict(pts=pts, s=seg, t0=t0 + i * 0.9 + rng.uniform(0, 0.8)))
+
+    def _skiers(self, rng) -> None:
+        n = 26
+        self.skiers = dict(offset=rng.uniform(0, 1, n), lane=rng.uniform(-22, 22, n), wiggle=rng.uniform(0, 6, n),
+                           color=np.array([props.SHIRTS[i] for i in rng.integers(0, len(props.SHIRTS), n)]))
+
+    # Dynamic ----------------------------------------------------------------
+
+    def dynamic(self, t: float, fx: Effects) -> Instances:
+        d = Instances()
+        self.crowd.draw(d, t)
+        self._draw_lift(d, t, fx)
+        self._draw_skiers(d, t)
+        smoke = 1.0 - ramp(t, self.timeline.t_flood, self.timeline.t_flood + 4)
+        near = self.chimneys[np.argsort(np.linalg.norm(self.chimneys - CAMERA, axis=1))[:16]]
+        # ponytail: one shared smoke base height (chimneys differ by ~2 m); per-chimney y0 if it ever shows
+        props.draw_puffs(d, near[:, 0], near[:, 2], float(near[:, 1].mean()), t, smoke, rgb("#8a90a0"), rise=1.8,
+                         spread=0.3, size=0.9, n_max=96)
+        self._draw_fires(d, t, fx)
+        self._draw_avalanches(d, t)
+        return d
+
+    def _draw_lift(self, d: Instances, t: float, fx: Effects) -> None:
+        stop = self.timeline.t_flood + 0.8
+        run = min(t, stop) * 2.5
+        for k, c in enumerate(self.cables):
+            seg = np.r_[0.0, np.cumsum(np.linalg.norm(np.diff(c, axis=0), axis=1))]
+            u = np.mod(np.arange(0.0, seg[-1], 32.0) + (run if k else -run), seg[-1])
+            p = np.stack([np.interp(u, seg, c[:, i]) for i in range(3)], 1)
+            d.add("box", chain(tr(p - (0, 3.4, 0)), sc((2.2, 1.4, 1.4))), rgb("#2a2a30"))
+
+    def _draw_skiers(self, d: Instances, t: float) -> None:
+        sk = self.skiers
+        period = 42.0
+        s = np.mod(t / period + sk["offset"], 1.0)
