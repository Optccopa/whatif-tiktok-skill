+def ski_look(scene: "WhatIfScene", t: float, fx: Effects, body_dir: np.ndarray, pos, look, fov) -> Frame:
+    """Blue hour in the snow: alpenglow on the slopes, then night, lit by the body and a few fires."""
+    import dataclasses
+
+    # The harbor's dusk palette, without its volcanoes or a city's worth of fire glow.
+    frame = harbor_look(scene, t, dataclasses.replace(fx, body_light=0.0, lava=0.0, fire=0.4 * fx.fire),
+                        body_dir, pos, look, fov)
+    night = ramp(t, 12.0, 38.0)
+    frame.zenith = _mix(frame.zenith, rgb("#050818"), night * 0.85)
+    frame.mid = _mix(frame.mid, rgb("#121836"), night * 0.8)
+    frame.horizon = _mix(frame.horizon, rgb("#2a2a48"), night * 0.75)
+    frame.amb_sky = _mix(frame.amb_sky, rgb("#2a3868", 0.5), night)
+    frame.amb_ground = _mix(frame.amb_ground, rgb("#1a1a2a", 0.5), night)
+    frame.cloud = _mix(frame.cloud, rgb("#1a1d34"), night)
+    # Its light: as bright as (its apparent area / the full Moon's) full moons, on a log scale.
+    full_moons = (fx.angular_radius / 0.00452) ** 2
+    k = min(max((math.log10(max(full_moons, 1.0)) - 1.0) / 2.2, 0.0), 1.0)
+    frame.body_light = rgb(scene.scenario.body.light_color, 1.6 * k ** 1.5)
+    moonlit = 0.45 * k
+    frame.zenith = _mix(frame.zenith, rgb("#1c2a5a"), moonlit)
+    frame.mid = _mix(frame.mid, rgb("#3a4a80"), moonlit)
+    frame.horizon = _mix(frame.horizon, rgb("#6a7098"), moonlit)
+    frame.fog_col = frame.horizon
+    frame.amb_sky = _mix(frame.amb_sky, rgb("#6a80c0", 0.6), moonlit)
+    frame.stars *= 1.0 - k
+    # The Sun has just set behind us: its last light glows pink on whatever faces it, then goes.
