+    frame.key_dir = _direction(-150.0, max(sun_el, 1.5))
+    frame.key_col = rgb("#ff9a86", 1.15 * glow)
+    frame.glow_col = rgb("#c8d6ff")  # a cool limb glow (the harbor's is warm, like an eclipse)
+    frame.exposure = 1.22
+    frame.frost = 0.85  # snow on every roof, rail and branch
+    frame.snow_line = -1000.0
+    frame.fog_density = 0.00011
+    return frame
